# MuseReel Docker 部署环境变量（复制为 .env 后修改）
# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# 使用自己发布的镜像时，填写镜像地址并启用拉取。
# MUSEREEL_IMAGE=registry.example.com/musereel:latest
# MUSEREEL_PULL_POLICY=always

# 使用 Watchtower 自动更新已发布的镜像时，取消下列注释并设置令牌。
# COMPOSE_PROFILES=updates
# MUSEREEL_AUTO_UPDATE=true
# MUSEREEL_WATCHTOWER_URL=http://watchtower:8080
# WATCHTOWER_TOKEN=replace-with-your-token
